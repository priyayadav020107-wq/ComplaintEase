# Rename this file to .env before running the server

# Port the Express server will listen on
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/complaintease
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/complaintease
MONGO_URI=mongodb://127.0.0.1:27017/complaintease

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret_key

# How long login tokens stay valid
JWT_EXPIRES_IN=7d
